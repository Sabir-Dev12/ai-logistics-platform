VITE_CHAT_HUB_URL=/hubs/chat
CHAT_BACKEND_URL=http://localhost:5192
# Optional local development bootstrap only; do not prefix this token with VITE_.
CHAT_DEV_ACCESS_TOKEN=

# Authentication: Vite proxies /api to this backend during development.
AUTH_BACKEND_URL=http://localhost:5192
# Optional public company context; leave empty to use the backend default.
VITE_AUTH_SOCIETE_KEY=

